{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code Report Tracker",
  "version": "0.1.0",
  "identifier": "com.codereporttracker",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Code Report Tracker",
      "width": 1440,
      "height": 900,
      "minWidth": 900,
      "minHeight": 600
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"]
  }
}
